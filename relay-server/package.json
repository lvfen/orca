{
  "name": "orca-relay-server",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable relay bridge that forwards opaque E2EE frames between an Orca desktop and one paired phone (see docs/mobile-relay-bridge.md).",
  "license": "MIT",
  "bin": {
    "relay-server": "./dist/cli.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "serve": "tsx src/cli.ts serve",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "generate-pair": "tsx src/cli.ts generate-pair",
    "revoke": "tsx src/cli.ts revoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --config ../.oxlintrc.json .",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "oxlint": "^1.67.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
